#!/usr/bin/nu

use bf
bf env load -x

# Add an nginx user with encrypted password
def main [
    name: string    # Username
    pass: string    # Password (will be encrypted using openssl)
]: nothing -> nothing {
    let args = [
        "passwd"
        "-apr1"
        $pass
    ]
    let encrypted_pass = ^openssl ...$args

    bf write $"Adding user ($name) with encrypted password..." "nginx-adduser"
    $"($name):($encrypted_pass)" | save --append "/etc/nginx/htpasswd"
    bf write ok "Done." "nginx-adduser"
}
