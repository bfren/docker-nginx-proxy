#!/usr/bin/nu

use bf
use bf-nginx
use bf/nginx/proxy *
bf env load -x

# Nginx configuration for all or a specific domain.
def main [
    --all (-a)              # Regenerate Nginx configuration for all domains (will take precedence over other options).
    --domain (-d): string   # Regenerate Nginx configuration for this domain.
    --force (-f)            # Force all configuration files to be deleted (even custom ones).
    --proxy (-p)            # Regenerate Nginx configuration for proxy domain.
]: nothing -> nothing {
    let domains = json get_domains
    if $all {
        $domains
            | each {|x| nginx regenerate_site_conf --force=($force) $x }
    } else if $proxy {
        $domains
            | where primary == (bf env PROXY_DOMAIN)
            | first
            | nginx regenerate_site_conf --force=($force) $in
    } else if not ($domain | is-empty) {
        $domains
            | where primary == $domain
            | first
            | nginx regenerate_site_conf --force=($force) $in
    } else {
        bf write error "You must use a flag to determine what action to take (try --help)." "nginx-regenerate"
    }

    bf-nginx reload
}
